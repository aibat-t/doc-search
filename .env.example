DOC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs
DOC_KAFKA_BOOTSTRAP=localhost:9092
DOC_EMBEDDING_MODEL=intfloat/multilingual-e5-base
DOC_EMBEDDING_DIM=768
DOC_CHUNK_MAX_TOKENS=350
DOC_CHUNK_OVERLAP_TOKENS=50
DOC_HNSW_EF_SEARCH=40
DOC_SEARCH_CANDIDATES=50
DOC_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# быстрее, но слабее: DOC_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# выключить reranker: DOC_RERANK_MODEL=
